{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "webfetch": "allow",
    "bash": {
      "*": "allow",
      "rm *": "ask",
      "del *": "ask",
      "rmdir *": "ask",
      "rd *": "ask",
      "Remove-Item*": "ask",
      "format *": "deny"
    }
  }
}
